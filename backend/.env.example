# SandboxIA Platform - Backend environment variables
# Copy this file to .env and adjust values for your environment

# PostgreSQL connection (matches docker-compose.yml)
DATABASE_URL="postgresql://sandboxia:sandboxia@localhost:5432/sandboxia?schema=public"

# Redis connection (matches docker-compose.yml)
REDIS_HOST=localhost
REDIS_PORT=6379

# Frontend URL for CORS (Next.js dev server)
FRONTEND_URL=http://localhost:3000

# Backend API port
PORT=4000

# Public URL of the backend (used in MCP config generated for each worktree)
# CLIs connect to <this URL>/mcp
ORCHESTRATOR_PUBLIC_URL=http://localhost:4000

# CLI profile for Master Agent (name of CliProfile in DB)
MASTER_AGENT_PROFILE=claude

# Optional: GitHub token for PR creation in Merge stage
# GITHUB_TOKEN=

# Optional: Enable POST /terminal/:id/execute (arbitrary execution — off by default)
# ALLOW_TERMINAL_EXEC=1

# Terminal provider: tmux | itmux | conpty | auto (auto = detect best available)
TERMINAL_PROVIDER=auto

# Path to itmux installation (Windows only, if using itmux provider)
# ITMUX_PATH=C:\itmux\tmux.exe

# Path to ia-framework directory (relative to project root or absolute)
IA_FRAMEWORK_PATH=../ia-framework